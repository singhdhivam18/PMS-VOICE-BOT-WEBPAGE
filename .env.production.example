# Copy to /opt/voiceops-deploy/.env.production on the VM, then fill in real values.
# Never commit the completed file to Git.

# Confirm backend/config/settings.py reads this exact environment variable name.
DJANGO_SECRET_KEY=REPLACE_WITH_A_LONG_RANDOM_SECRET
DJANGO_DEBUG=False
DJANGO_ALLOWED_HOSTS=129.121.134.68,127.0.0.1,localhost

# Use the existing PostgreSQL database and credentials; do not create a new DB blindly.
DB_HOST=129.121.134.68
DB_PORT=5432
DB_NAME=dev-voice-db
DB_USER=postgres
DB_PASSWORD=Test@123
DB_DRIVER=PostgreSQL Unicode(x64)

# Compose overrides the storage settings to use the existing read-only /upload mount.
VOICEOPS_DOCUMENT_STORAGE_BACKEND=filesystem
VOICEOPS_MEDIA_ROOT=/upload

# Optional: preserve any other environment values your settings.py or app code needs.
