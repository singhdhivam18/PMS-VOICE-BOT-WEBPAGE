# Django - use a unique secret key in each environment
DJANGO_SECRET_KEY=replace-this-with-a-long-random-secret
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=127.0.0.1,localhost

# Existing PostgreSQL database. Do not commit real credentials.
DB_NAME=voice_bot_db
DB_USER=postgres
DB_PASSWORD=change-me
DB_HOST=127.0.0.1
DB_PORT=5432

# React dev origin
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# DOCUMENT FILE ACCESS
# Local development on Windows: read files over SFTP (no HTTP server required).
VOICEOPS_DOCUMENT_STORAGE_BACKEND=sftp
VOICEOPS_SFTP_HOST=129.121.134.68
VOICEOPS_SFTP_PORT=22
VOICEOPS_SFTP_USERNAME=stockuser
VOICEOPS_SFTP_PASSWORD=
# Prefer a private key. Use a Windows path with forward slashes, e.g. C:/Users/YourUser/.ssh/voiceops_vm
VOICEOPS_SFTP_PRIVATE_KEY_FILE=
VOICEOPS_SFTP_KNOWN_HOSTS=
# Set this to the server-side path as seen by the SFTP account. Common values are /upload or /.
VOICEOPS_SFTP_REMOTE_ROOT=/upload

# Production, when Django runs on the same VM and can read files from the filesystem:
# VOICEOPS_DOCUMENT_STORAGE_BACKEND=filesystem
# VOICEOPS_MEDIA_ROOT=/upload

# Legacy HTTP mode only if a real web server serves these file URLs (not required for SFTP/filesystem):
# VOICEOPS_DOCUMENT_STORAGE_BACKEND=http
# VOICEOPS_MEDIA_BASE_URL=https://your-file-server.example
